{
  "name": "nestjs-latam-payments",
  "version": "0.1.0",
  "description": "One NestJS API for Stripe, PayPal, Mercado Pago, Wompi and PayU LATAM: checkout, payment status, refunds and verified webhooks with normalized events.",
  "keywords": [
    "nestjs",
    "payments",
    "latam",
    "stripe",
    "paypal",
    "mercadopago",
    "mercado-pago",
    "wompi",
    "payu",
    "payu-latam",
    "pse",
    "nequi",
    "pix",
    "colombia",
    "mexico",
    "brasil",
    "webhooks",
    "checkout",
    "typescript"
  ],
  "author": "Javier Cardona (https://javiercardona.dev)",
  "license": "MIT",
  "homepage": "https://github.com/JavierCardonadev/nestjs-latam-payments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierCardonadev/nestjs-latam-payments.git"
  },
  "bugs": {
    "url": "https://github.com/JavierCardonadev/nestjs-latam-payments/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:live": "LIVE=1 vitest run test/live",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
